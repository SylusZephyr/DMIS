# --- Secrets ---
# No real .env has ever existed in this project (verified before writing
# this file) -- ANTHROPIC_API_KEY has never been configured. This rule
# exists so one is never committed if/when it is.
.env
.env.*
!.env.example
# production settings and secrets (scripts/deploy.py init writes it)
infra/prod.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
# None currently exists in this project (dependencies were installed into
# the global user site-packages) -- kept for whenever one is created.
.venv/
venv/
env/
ENV/

# --- Test / tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Generated database ---
# Fully derived state -- regenerate with scripts/ingest.py,
# scripts/classify.py, scripts/resolve_products.py,
# scripts/calculate_market.py, scripts/detect_opportunities.py in that
# order (see PROGRESS.md). Never a source of truth; would also bloat the
# repo and produce spurious diffs/merge conflicts as a binary file.
*.duckdb
*.duckdb.wal

# --- Generated pipeline outputs ---
# Mechanically regenerated from data/raw/ + the DB on every script run
# (each script deletes and rewrites its own output -- see DECISIONS.md).
# No independent judgment or irreplaceable work lives in these paths.
data/interim/
data/processed/
data/exports/
data/samples/*.csv

# Data Ingestion Center temporary storage (Milestone 16) -- an uploaded
# file staged here before validation/approval, never itself a source of
# truth (approval copies it into data/raw/, which IS tracked).
data/staging/

# --- Oversized raw source file ---
# The original ~54KB denture_base pilot export was small enough to track
# directly. A later, much broader real merged multi-category export
# (2026-09-24) is 172MB -- GitHub hard-rejects any single file over
# 100MB without Git LFS, which this project doesn't use. Excluded here
# rather than committed and having the push fail; the smaller
# per-category slices scripts/extract_from_merged_export.py derived
# from it (data/raw/dental_models/, data/raw/implants/, both well under
# 1MB) ARE tracked normally, same as every other data/raw/** file.
data/raw/denture_base/denture_base_sellersprite_v1.xlsx

# NOT ignored, deliberately:
#   data/raw/**            - real source exports everything else in this
#                             project derives from (except the one
#                             172MB file excluded just above)
#   data/samples/*.xlsx    - the human/model-labeled gold pilot sample;
#                             the labeling judgment in it cannot be
#                             regenerated by re-running a script
#   data/validated/**      - the frozen gold benchmark tests depend on

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/

# --- Logs ---
*.log

# --- Intelligence Platform v2 generated state ---
# Lake (Parquet zones), embedded business/graph/analytics DBs, Qdrant local
# storage: all regenerated by `python scripts/dmis.py bootstrap`.
data/lake/
data/platform/
data/bench/
