# Copy to infra/prod.env (never commit it) and change every value.
DMIS_DOMAIN=localhost              # your domain, e.g. dmis.example.com (Caddy gets a certificate)
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me-too
DMIS_WEB=frontend-v2               # command center to build: frontend-v2 or frontend
# optional: an AI provider key turns on answer phrasing, translation and the LLM attribute tier
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DIP_SMTP_HOST=
DIP_SMTP_PORT=587
DIP_SMTP_USER=
DIP_SMTP_PASSWORD=
DIP_SMTP_FROM=dmis@example.com
DIP_CORS_ORIGINS=https://localhost
# scale and operations
DIP_API_WORKERS=2                  # uvicorn processes in the api container
DIP_LOG_FORMAT=json                # json (for log shippers) or text
SENTRY_DSN=                        # optional error reporting
