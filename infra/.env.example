# Copy to .env (project root) or export before `uvicorn dip.api.app:app`.
# Leave any variable empty to use the embedded fallback for that store.
DIP_POSTGRES_URL=postgresql+psycopg://dip:dip@localhost:5432/dip
DIP_NEO4J_URI=bolt://localhost:7687
DIP_NEO4J_USER=neo4j
DIP_NEO4J_PASSWORD=dip-password
DIP_QDRANT_URL=http://localhost:6333
# DIP_DATA_DIR=data/platform
# DIP_LAKE_DIR=data/lake

# Frontend (build time): optional Mapbox 2D map on the Command Center.
# Without it the 3D globe is the only (fully working) view.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
