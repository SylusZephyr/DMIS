# Copy this file to .env and fill in a real key to enable every AI-using
# stage (relevance classification, product-type classification, entity
# resolution arbitration, review extraction, the AI Market Analyst).
# .env is gitignored -- never commit a real key.
#
# Without this configured, every AI stage gracefully falls back to
# rules-only / "AI unavailable" (see src/dmie/ai/client.py) -- the
# pipeline and dashboard both work fully either way.
ANTHROPIC_API_KEY=
# Market Analyst phrasing (Google Gemini free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Live Amazon data (docs/LIVE_DATA.md) -- optional; uploads of SellerSprite exports work without any of these
# Keepa (recommended: listings, 12-month history, sales badges, FBA fees): https://keepa.com/#!api
DIP_KEEPA_API_KEY=
# A data API for review text / search results (any vendor; request templates in config/platform/acquisition.yaml)
DIP_SCRAPER_API_KEY=
DIP_SCRAPER_API_URL=
# Amazon Product Advertising API 5.0 (needs an Associates account)
DIP_PAAPI_ACCESS_KEY=
DIP_PAAPI_SECRET_KEY=
DIP_PAAPI_PARTNER_TAG=

# --- Chinese marketplaces for supplier sourcing (docs/SOURCING.md) -- optional
DIP_1688_APP_KEY=
DIP_1688_APP_SECRET=
DIP_ALIEXPRESS_APP_KEY=
DIP_ALIEXPRESS_APP_SECRET=
DIP_ALIEXPRESS_TRACKING_ID=
# Alibaba.com / Taobao / Made-in-China through a data-API vendor
DIP_ALIBABA_API_KEY=
DIP_ALIBABA_API_URL=
DIP_TAOBAO_API_KEY=
DIP_TAOBAO_API_URL=
DIP_MIC_API_KEY=
DIP_MIC_API_URL=
